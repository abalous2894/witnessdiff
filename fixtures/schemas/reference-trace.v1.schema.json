{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://witnessdiff.dev/schemas/reference-trace.v1.schema.json",
  "title": "witnessdiff.reference-trace/v1",
  "type": "object",
  "required": ["schema", "session_id", "source", "actions"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "witnessdiff.reference-trace/v1" },
    "session_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["index", "tool_name"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "tool_name": { "type": "string", "minLength": 1 },
        "action_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "arguments_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "verdict": { "type": "string" }
      }
    }
  }
}
